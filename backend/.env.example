# Avatario — AI Human Assistant Platform
# Copy this file to .env and fill in your values

# Sarvam AI (STT + TTS) — https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM Backend (OpenAI-compatible endpoint)
VLLM_API_KEY=EMPTY
VLLM_API_BASE=https://your-llm-endpoint/v1
VLLM_MODEL=your-model-name

# RAG / Brain API
BRAIN_API_URL=http://localhost:8000

# LiveKit (WebRTC transport) — https://livekit.io
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# NVIDIA Audio2Face (lip-sync Tier 2) — https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# D-ID (lip-sync Tier 3, optional) — https://www.d-id.com
DID_API_KEY=your_did_api_key_here

# Duix.Avatar API (lip-sync Tier 4, stunning HD) — https://docs.duix.com
DUIX_API_KEY=your_duix_api_key_here
